<%- include('../partials/header') %>
<%- include('../partials/subheader') %>

<%
  const siteDomain = (typeof settings !== 'undefined' && settings.site_domain) 
    ? (settings.site_domain.startsWith('http') ? settings.site_domain.replace(/\/$/, '') : 'https://' + settings.site_domain.replace(/\/$/, ''))
    : 'https://odishaaspirants.com';
%>

<!-- Schema.org JSON-LD Structured Data: BreadcrumbList, WebApplication, and FAQPage -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "BreadcrumbList",
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "<%= siteDomain %>"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": "Candidate Utilities",
          "item": "<%= siteDomain %>"
        },
        {
          "@type": "ListItem",
          "position": 3,
          "name": "Government Exam Online Age Calculator",
          "item": "<%= siteDomain %>/tools/age-calculator"
        }
      ]
    },
    {
      "@type": "WebApplication",
      "name": "Government Exam Online Age Calculator 2026",
      "url": "<%= siteDomain %>/tools/age-calculator",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "All",
      "browserRequirements": "Requires JavaScript. Requires HTML5.",
      "description": "Calculate exact age in years, months, and days as on the official recruitment notification cutoff date for SSC, UPSC, Railway, Police, and Banking examinations.",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": "INR"
      }
    },
    {
      "@type": "FAQPage",
      "mainEntity": [
        {
          "@type": "Question",
          "name": "How is age calculated for Government Exam application forms?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "In competitive recruitment notifications such as SSC, UPSC, RRB, and State Police, age is determined as of a specific cutoff date (usually 1st January, 1st July, or 1st August of the notification year) using your Date of Birth recorded in your 10th / Matriculation passing certificate."
          }
        },
        {
          "@type": "Question",
          "name": "What is the standard age relaxation for OBC, SC, and ST candidates?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "Under Central and State Government norms, OBC (Non-Creamy Layer) candidates typically receive 3 years of upper age relaxation, SC and ST candidates receive 5 years, and PwBD candidates receive 10 to 15 years of relaxation depending on the recruitment rules."
          }
        },
        {
          "@type": "Question",
          "name": "Which document is considered final proof of Date of Birth for Sarkari jobs?",
          "acceptedAnswer": {
            "@type": "Answer",
            "text": "The Matriculation (10th Standard / High School) Board Examination Certificate or Marksheet containing your verified Date of Birth is considered the sole authentic legal document for date of birth verification across all Indian recruitment boards."
          }
        }
      ]
    }
  ]
}
</script>

<main class="container tool-page-container">
  <!-- SEO & AdSense Compliant Breadcrumb -->
  <nav class="tool-page-breadcrumb" aria-label="Breadcrumb">
    <a href="/">🏠 Home</a>
    <span class="crumb-sep">»</span>
    <span>Candidate Utilities</span>
    <span class="crumb-sep">»</span>
    <span class="crumb-active">Government Exam Age Calculator</span>
  </nav>

  <div class="sarkari-box" style="margin-bottom: 25px;">
    <h1 class="sarkari-box-header" style="margin: 0; font-size: 16.5px; line-height: 1.35; padding: 12px 18px;">
      Government Exam Online Age Calculator 2026 : Exact Age (Cutoff Date)
    </h1>

    <div style="padding: 22px 25px;">
      <p style="font-size: 14.5px; color: #374151; line-height: 1.65; margin: 0 0 18px 0;">
        Use this verified online utility to calculate your <b>exact age in Years, Months, and Days</b> as on the specific reference cutoff date mentioned in any Central or State Government recruitment notification (including <b>SSC, UPSC, Railway RRB, State Police, Banking IBPS/SBI, Teaching, and Defence</b>).
      </p>

      <div style="max-width: 520px; margin: 0 auto 25px auto; background: #fffdf5; border: 2px solid #ffd480; padding: 22px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.05);">
        <div style="margin-bottom: 16px;">
          <label for="dobInput" style="display: block; font-weight: bold; margin-bottom: 6px; color: #1e293b; font-size: 14px;">
            🎂 Your Date of Birth (As per 10th Certificate):
          </label>
          <input type="date" id="dobInput" style="width: 100%; padding: 10px 12px; font-size: 15px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #ffffff;">
        </div>

        <div style="margin-bottom: 20px;">
          <label for="asOnInput" style="display: block; font-weight: bold; margin-bottom: 6px; color: #1e293b; font-size: 14px;">
            📅 Age as on Cutoff Date (From Exam Notification):
          </label>
          <input type="date" id="asOnInput" value="2026-08-01" style="width: 100%; padding: 10px 12px; font-size: 15px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; background: #ffffff;">
          <div style="font-size: 12px; color: #64748b; margin-top: 5px;">
            Tip: Most SSC &amp; UPSC 2026 exams have cutoff dates as <b>01/01/2026</b> or <b>01/08/2026</b>.
          </div>
        </div>

        <button type="button" id="calcBtn" style="width: 100%; background: var(--primary-red); color: #fff; font-weight: 700; font-size: 16px; padding: 12px; border: none; border-radius: 4px; cursor: pointer; transition: background 0.15s ease;">
          ⚡ Calculate Exact Age
        </button>

        <div id="ageResult" style="display: none; margin-top: 20px; padding: 16px; background: #ffffff; border: 2px solid #ab183d; border-radius: 6px; text-align: center; box-shadow: 0 4px 12px rgba(171, 24, 61, 0.08);">
          <div style="font-size: 12.5px; color: #64748b; font-weight: 600; text-transform: uppercase; letter-spacing: 0.5px;">Your Exact Calculated Age:</div>
          <div id="ageOutput" style="font-size: 24px; font-weight: 800; color: var(--primary-red); margin: 8px 0;"></div>
          <div id="daysOutput" style="font-size: 13px; color: #15803d; font-weight: 700;"></div>
        </div>
      </div>

      <!-- Rich Educational Content for Google AdSense & Candidate E-E-A-T Value -->
      <div style="border-top: 1px solid #e2e8f0; padding-top: 25px; margin-top: 20px; color: #334155; line-height: 1.7; font-size: 14px;">
        <h2 style="color: var(--primary-red); font-size: 18px; margin: 0 0 12px 0;">
          📌 Standard Age Limits Across Major Government Examinations (2026)
        </h2>
        <p style="margin-bottom: 14px;">
          Every government department specifies minimum and maximum age criteria for applicants. Candidates must satisfy both criteria as of the notified cutoff date to prevent online form rejection during document scrutiny:
        </p>

        <div class="table-responsive" style="margin-bottom: 22px;">
          <table class="detail-table">
            <thead>
              <tr style="background: #2b547e; color: #fff;">
                <th style="width: 32%;">Recruitment Examination</th>
                <th style="width: 25%;">Standard Age Limit</th>
                <th style="width: 43%;">Educational Eligibility</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>UPSC Civil Services (IAS / IPS / IFS)</b></td>
                <td><b style="color: var(--primary-red);">21 to 32 Years</b></td>
                <td>Bachelor's Degree in any stream from recognized university</td>
              </tr>
              <tr>
                <td><b>SSC CGL (Combined Graduate Level)</b></td>
                <td><b style="color: var(--primary-red);">18 to 32 Years</b></td>
                <td>Graduation Degree (Age criteria varies by post: 18-27, 20-30, 18-32)</td>
              </tr>
              <tr>
                <td><b>SSC CHSL (10+2 Level)</b></td>
                <td><b style="color: var(--primary-red);">18 to 27 Years</b></td>
                <td>12th Intermediate Pass in relevant stream</td>
              </tr>
              <tr>
                <td><b>Railway Recruitment Boards (RRB NTPC)</b></td>
                <td><b style="color: var(--primary-red);">18 to 33 / 36 Years</b></td>
                <td>12th Pass (Undergraduate) or Degree (Graduate Level)</td>
              </tr>
              <tr>
                <td><b>State Police Recruitment (Constable / SI)</b></td>
                <td><b style="color: var(--primary-red);">18 to 25 / 28 Years</b></td>
                <td>12th Pass for Constable, Graduate for Sub-Inspector</td>
              </tr>
              <tr>
                <td><b>Banking (IBPS / SBI PO &amp; Clerk)</b></td>
                <td><b style="color: var(--primary-red);">20 to 30 Years</b></td>
                <td>Any Recognized Degree (Clerk: 20-28 yrs, PO: 20-30 yrs)</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 style="color: var(--primary-red); font-size: 18px; margin: 24px 0 12px 0;">
          🛡️ Government Category-Wise Age Relaxation Norms
        </h2>
        <p style="margin-bottom: 14px;">
          Reserved category candidates from OBC, SC, ST, EWS, PwBD, and Ex-Servicemen categories are entitled to upper age relaxation over and above the general category maximum age:
        </p>
        <div class="table-responsive" style="margin-bottom: 22px;">
          <table class="detail-table">
            <thead>
              <tr style="background: #ab183d; color: #fff;">
                <th style="width: 45%;">Candidate Category</th>
                <th style="width: 55%;">Standard Upper Age Relaxation</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><b>Other Backward Classes (OBC - Non Creamy Layer)</b></td>
                <td><b>+3 Years</b> relaxation in upper age limit</td>
              </tr>
              <tr>
                <td><b>Scheduled Castes / Scheduled Tribes (SC / ST)</b></td>
                <td><b>+5 Years</b> relaxation in upper age limit</td>
              </tr>
              <tr>
                <td><b>Persons with Benchmark Disabilities (PwBD - General / EWS)</b></td>
                <td><b>+10 Years</b> relaxation in upper age limit</td>
              </tr>
              <tr>
                <td><b>Persons with Benchmark Disabilities (PwBD - OBC NCL)</b></td>
                <td><b>+13 Years</b> relaxation in upper age limit</td>
              </tr>
              <tr>
                <td><b>Persons with Benchmark Disabilities (PwBD - SC / ST)</b></td>
                <td><b>+15 Years</b> relaxation in upper age limit</td>
              </tr>
              <tr>
                <td><b>Ex-Servicemen (ESM)</b></td>
                <td><b>3 Years</b> after deduction of military service rendered from actual age</td>
              </tr>
            </tbody>
          </table>
        </div>

        <h2 style="color: var(--primary-red); font-size: 18px; margin: 24px 0 12px 0;">
          ❓ Frequently Asked Questions (FAQs)
        </h2>
        <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 6px; padding: 16px 20px;">
          <h3 style="font-size: 15px; margin: 0 0 6px 0; color: #0f172a;">Q1: How do I know the cutoff date for an exam?</h3>
          <p style="margin: 0 0 16px 0; color: #475569; font-size: 13.5px;">
            The cutoff date is always explicitly stated under the "Age Limit" section of the official recruitment notification (PDF). Enter that exact date into the "Age as on Date" field above.
          </p>

          <h3 style="font-size: 15px; margin: 0 0 6px 0; color: #0f172a;">Q2: What happens if I am 1 day over the maximum age limit?</h3>
          <p style="margin: 0 0 16px 0; color: #475569; font-size: 13.5px;">
            Recruitment software automatically rejects applications that exceed the prescribed age limit even by a single day on the cutoff date. Reserved category applicants must claim their valid relaxation during registration.
          </p>

          <h3 style="font-size: 15px; margin: 0 0 6px 0; color: #0f172a;">Q3: Which documents are needed to claim age relaxation?</h3>
          <p style="margin: 0; color: #475569; font-size: 13.5px;">
            Candidates must produce a valid Central/State Caste Certificate (for OBC/SC/ST) issued by a Competent Revenue Authority (e.g., Tehsildar or Sub-Divisional Magistrate) or Disability Certificate (for PwBD) dated before the closing date.
          </p>
        </div>
      </div>
    </div>
  </div>
</main>

<script>
document.getElementById('calcBtn').addEventListener('click', function() {
  const dobVal = document.getElementById('dobInput').value;
  const asOnVal = document.getElementById('asOnInput').value;

  if (!dobVal || !asOnVal) {
    alert('Please select both your Date of Birth and the Cutoff Date.');
    return;
  }

  const birthDate = new Date(dobVal);
  const targetDate = new Date(asOnVal);

  if (targetDate < birthDate) {
    alert('Cutoff date cannot be earlier than your date of birth.');
    return;
  }

  let years = targetDate.getFullYear() - birthDate.getFullYear();
  let months = targetDate.getMonth() - birthDate.getMonth();
  let days = targetDate.getDate() - birthDate.getDate();

  if (days < 0) {
    months -= 1;
    const prevMonthDays = new Date(targetDate.getFullYear(), targetDate.getMonth(), 0).getDate();
    days += prevMonthDays;
  }

  if (months < 0) {
    years -= 1;
    months += 12;
  }

  const totalDiffTime = Math.abs(targetDate - birthDate);
  const totalDays = Math.ceil(totalDiffTime / (1000 * 60 * 60 * 24));

  document.getElementById('ageOutput').textContent = `${years} Years, ${months} Months, ${days} Days`;
  document.getElementById('daysOutput').textContent = `Total Days Lived: ${totalDays.toLocaleString('en-IN')} Days`;
  document.getElementById('ageResult').style.display = 'block';
});
</script>

<%- include('../partials/footer') %>

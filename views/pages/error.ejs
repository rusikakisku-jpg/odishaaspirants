<%- include('../partials/header') %>
<%- include('../partials/subheader') %>

<main class="container">
  <div class="sarkari-box" style="margin: 40px auto; max-width: 600px; text-align: center;">
    <div class="sarkari-box-header">
      <%= title %>
    </div>
    <div style="padding: 40px 20px;">
      <h2 style="color: var(--primary-red); font-size: 26px; margin-bottom: 12px;"><%= title %></h2>
      <p style="font-size: 15px; color: #555; margin-bottom: 25px;"><%= message %></p>
      <a href="/" style="display: inline-block; background: var(--primary-red); color: #fff; padding: 10px 20px; font-weight: bold; border-radius: 4px; text-decoration: none;">
        ← Back to Homepage
      </a>
    </div>
  </div>
</main>

<%- include('../partials/footer') %>

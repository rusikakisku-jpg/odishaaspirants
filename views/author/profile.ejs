<%- include('../partials/author-nav', { currentPath: '/author-portal/profile' }) %>

<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h2><%= (typeof isEditor !== 'undefined' && isEditor) ? 'Editor Profile &amp; Account Settings' : 'Author Profile &amp; Account Settings' %></h2>
      <div style="font-size: 12.5px; color: #64748b; margin-top: 2px;">
        Update your internal credentials, bio, and account login password
      </div>
    </div>
    <a href="/" target="_blank" class="btn btn-secondary btn-sm">🌐 Live Website</a>
  </div>

  <% if (typeof success !== 'undefined' && success) { %>
    <div style="background: #dcfce7; border: 1px solid #86efac; color: #166534; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-weight: 600;">
      ✅ <%= success === 'password_and_profile_saved' ? 'Profile details and account password updated successfully!' : 'Author profile details saved successfully!' %>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div style="background: #fee2e2; border: 1px solid #fca5a5; color: #991b1b; padding: 12px 16px; border-radius: 6px; margin-bottom: 20px; font-weight: 600;">
      ⚠️ <%= error === 'passwords_mismatch' ? 'New password and Confirm password do not match.' : (error === 'invalid_current_password' ? 'Current password was incorrect. Please try again.' : 'An error occurred. Please check the form.') %>
    </div>
  <% } %>

  <form action="/author-portal/profile" method="POST">
    <!-- Section 1: Public Identity & Credentials -->
    <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
      <h3 style="margin-top: 0; margin-bottom: 14px; font-size: 15px; color: #1e293b; display: flex; align-items: center; gap: 8px;">
        <span>👤</span> Public Identity &amp; E-E-A-T Credentials
      </h3>

      <div class="form-row">
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Full Name *</label>
          <input type="text" name="name" class="form-control" value="<%= author.name %>" required>
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Role / Professional Title *</label>
          <input type="text" name="role" class="form-control" value="<%= author.role %>" required>
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Official Email</label>
          <input type="email" name="email" class="form-control" value="<%= author.email || '' %>">
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Educational Qualification</label>
          <input type="text" name="qualification" class="form-control" value="<%= author.qualification || '' %>" placeholder="e.g. Master of Public Administration, NET Qualified">
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Experience Summary</label>
          <input type="text" name="experience" class="form-control" value="<%= author.experience || '' %>" placeholder="e.g. 8+ Years Competitive Exam Reporting">
        </div>
        <div class="form-group" style="grid-column: span 2;">
          <label style="font-size: 12.5px; font-weight: 600;">Avatar Image URL</label>
          <input type="text" name="avatar_url" class="form-control" value="<%= author.avatar_url || '/images/default-avatar.svg' %>">
        </div>
      </div>

      <div class="form-group" style="margin-bottom: 0;">
        <label style="font-size: 12.5px; font-weight: 600;">Editorial Bio / Verification Statement *</label>
        <textarea name="bio" class="form-control" rows="3" required><%= author.bio || '' %></textarea>
        <small style="color: #64748b; font-size: 11.5px; margin-top: 4px; display: block;">
          This statement appears on your public author profile and under every recruitment post you verify.
        </small>
      </div>
    </div>

    <!-- Section 2: Social & Verification Channels -->
    <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
      <h3 style="margin-top: 0; margin-bottom: 14px; font-size: 15px; color: #1e293b; display: flex; align-items: center; gap: 8px;">
        <span>🌐</span> Social &amp; Verification Channels
      </h3>

      <div class="form-row">
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Telegram Profile URL</label>
          <input type="url" name="telegram_url" class="form-control" value="<%= author.telegram_url || '' %>" placeholder="https://t.me/...">
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Twitter / X Profile URL</label>
          <input type="url" name="twitter_url" class="form-control" value="<%= author.twitter_url || '' %>" placeholder="https://twitter.com/...">
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">LinkedIn Profile URL</label>
          <input type="url" name="linkedin_url" class="form-control" value="<%= author.linkedin_url || '' %>" placeholder="https://linkedin.com/in/...">
        </div>
      </div>
    </div>

    <!-- Section 3: Change Password -->
    <div style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 20px; margin-bottom: 24px;">
      <h3 style="margin-top: 0; margin-bottom: 8px; font-size: 15px; color: #1e293b; display: flex; align-items: center; gap: 8px;">
        <span>🔒</span> Change Author Password
      </h3>
      <div style="font-size: 12px; color: #64748b; margin-bottom: 14px;">
        Leave blank if you do not wish to change your password.
      </div>

      <div class="form-row">
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Current Password</label>
          <input type="password" name="current_password" class="form-control" placeholder="Enter current password">
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">New Password</label>
          <input type="password" name="new_password" class="form-control" placeholder="Minimum 6 characters">
        </div>
        <div class="form-group">
          <label style="font-size: 12.5px; font-weight: 600;">Confirm New Password</label>
          <input type="password" name="confirm_password" class="form-control" placeholder="Re-type new password">
        </div>
      </div>
    </div>

    <div>
      <button type="submit" class="btn btn-primary" style="background: #2563eb; border-color: #1d4ed8; padding: 11px 26px; font-size: 14.5px;">
        💾 Save Profile &amp; Account Changes
      </button>
      <a href="/author-portal" class="btn btn-secondary" style="margin-left: 10px;">Cancel</a>
    </div>
  </form>
</div>

<%- include('../partials/author-footer') %>

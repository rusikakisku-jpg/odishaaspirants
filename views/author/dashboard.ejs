<%- include('../partials/author-nav', { currentPath: '/author-portal' }) %>

<!-- Welcome Banner -->
<div style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); border-radius: 12px; padding: 22px 26px; margin-bottom: 24px; color: #ffffff; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.1);">
  <div>
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 6px;">
      <span style="background: <%= (typeof isEditor !== 'undefined' && isEditor) ? 'rgba(16, 185, 129, 0.25)' : 'rgba(37, 99, 235, 0.25)' %>; color: <%= (typeof isEditor !== 'undefined' && isEditor) ? '#6ee7b7' : '#93c5fd' %>; font-size: 11.5px; font-weight: 700; padding: 2px 8px; border-radius: 12px; border: 1px solid <%= (typeof isEditor !== 'undefined' && isEditor) ? 'rgba(16, 185, 129, 0.35)' : 'rgba(37, 99, 235, 0.35)' %>;">
        <%= (typeof isEditor !== 'undefined' && isEditor) ? '● Senior Editor Workspace Active' : '● Author Workspace Active' %>
      </span>
      <span style="color: #94a3b8; font-size: 12px;"><%= (typeof isEditor !== 'undefined' && isEditor) ? 'Full Platform Editorial Review &amp; Publishing Desk' : 'Verified Recruitment &amp; Fact-Checking Desk' %></span>
    </div>
    <h1 style="font-size: 22px; font-weight: 800; margin: 0 0 6px 0; letter-spacing: -0.5px;">
      Welcome back, <%= author.name %>!
    </h1>
    <p style="color: #94a3b8; font-size: 13.5px; margin: 0;">
      <%= author.role %> • <%= (typeof isEditor !== 'undefined' && isEditor) ? 'Review recruitment notifications submitted across all contributors, update posts, and maintain publishing standards.' : 'Manage your published recruitment notifications and draft new posts.' %>
    </p>
  </div>
  <div style="display: flex; gap: 10px; flex-wrap: wrap;">
    <a href="/author-portal/posts/new" class="btn btn-primary" style="background: <%= (typeof isEditor !== 'undefined' && isEditor) ? '#059669' : '#2563eb' %>; border-color: <%= (typeof isEditor !== 'undefined' && isEditor) ? '#047857' : '#1d4ed8' %>; padding: 10px 18px; font-size: 13.5px;">
      ➕ Write New Article
    </a>
    <a href="/author-portal/posts" class="btn btn-secondary" style="background: rgba(255,255,255,0.1); color: #ffffff; border-color: rgba(255,255,255,0.2);">
      <%= (typeof isEditor !== 'undefined' && isEditor) ? '📋 Review All Posts' : '📝 View My Articles' %>
    </a>
  </div>
</div>

<!-- 4 Author Stat Cards -->
<div class="stats-grid">
  <div class="stat-card">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h3><%= (typeof isEditor !== 'undefined' && isEditor) ? 'Platform Total Articles' : 'My Total Articles' %></h3>
        <div class="stat-val"><%= stats.totalPosts %></div>
        <div class="stat-sub" style="color: #2563eb; font-weight: 600;">
          <%= (typeof isEditor !== 'undefined' && isEditor) ? 'Across All Authors' : 'Authored by you' %>
        </div>
      </div>
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #eff6ff; color: #2563eb; display: flex; align-items: center; justify-content: center; font-size: 20px;">
        📝
      </div>
    </div>
  </div>

  <div class="stat-card">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h3>Live &amp; Published</h3>
        <div class="stat-val" style="color: #16a34a;"><%= stats.activePosts %></div>
        <div class="stat-sub" style="color: #16a34a; font-weight: 600;">
          Active on Website
        </div>
      </div>
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #f0fdf4; color: #16a34a; display: flex; align-items: center; justify-content: center; font-size: 20px;">
        ✅
      </div>
    </div>
  </div>

  <div class="stat-card">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h3>Drafts</h3>
        <div class="stat-val" style="color: #d97706;"><%= stats.draftPosts %></div>
        <div class="stat-sub" style="color: #d97706; font-weight: 600;">
          In progress / Review
        </div>
      </div>
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #fef3c7; color: #d97706; display: flex; align-items: center; justify-content: center; font-size: 20px;">
        ⏳
      </div>
    </div>
  </div>

  <div class="stat-card">
    <div style="display: flex; justify-content: space-between; align-items: flex-start;">
      <div>
        <h3>Candidate Views</h3>
        <div class="stat-val" style="color: #0284c7;"><%= (stats.totalViews || 0).toLocaleString() %></div>
        <div class="stat-sub" style="color: #0284c7; font-weight: 600;">
          <%= (typeof isEditor !== 'undefined' && isEditor) ? 'Total Platform Reads' : 'Across your articles' %>
        </div>
      </div>
      <div style="width: 44px; height: 44px; border-radius: 10px; background: #e0f2fe; color: #0284c7; display: flex; align-items: center; justify-content: center; font-size: 20px;">
        👁️
      </div>
    </div>
  </div>
</div>

<!-- Author Bio & Credentials Summary Card -->
<div class="admin-card" style="margin-bottom: 24px;">
  <div style="display: flex; gap: 20px; align-items: center; flex-wrap: wrap;">
    <img src="<%= author.avatar_url || '/images/default-avatar.svg' %>" alt="<%= author.name %>" style="width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 3px solid #e2e8f0;">
    <div style="flex: 1; min-width: 260px;">
      <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
        <h2 style="margin: 0; font-size: 18px; color: #1e293b;"><%= author.name %></h2>
        <span style="background: #dcfce7; color: #166534; font-size: 11px; font-weight: 700; padding: 2px 8px; border-radius: 999px;">✓ Verified Author</span>
        <span style="color: #64748b; font-size: 12px; font-family: monospace;">@<%= author.slug %></span>
      </div>
      <div style="color: #2563eb; font-weight: 600; font-size: 13.5px; margin: 3px 0 6px 0;">
        <%= author.role %>
      </div>
      <p style="margin: 0; font-size: 13px; color: #475569; line-height: 1.5;">
        <%= author.bio || 'Government recruitment analyst and exam fact-checker at Govt Exam Zone.' %>
      </p>
    </div>
    <div style="display: flex; gap: 8px;">
      <a href="/author-portal/profile" class="btn btn-secondary btn-sm">⚙️ Edit Profile &amp; Password</a>
    </div>
  </div>
</div>

<!-- Recent Articles Authored Table -->
<div class="admin-card">
  <div class="admin-card-header">
    <div>
      <h2><%= (typeof isEditor !== 'undefined' && isEditor) ? 'Platform Notifications & Articles' : 'Recent Notifications Authored by You' %></h2>
      <div style="font-size: 12.5px; color: #64748b; margin-top: 2px;">
        <%= (typeof isEditor !== 'undefined' && isEditor) ? 'Showing latest published and draft notifications submitted across all contributors' : 'Showing latest published and draft recruitment notifications with candidate views' %>
      </div>
    </div>
    <div style="display: flex; gap: 8px;">
      <a href="/author-portal/posts" class="btn btn-secondary btn-sm"><%= (typeof isEditor !== 'undefined' && isEditor) ? 'View All Platform Posts' : 'View All My Posts' %></a>
      <a href="/author-portal/posts/new" class="btn btn-primary btn-sm" style="background: <%= (typeof isEditor !== 'undefined' && isEditor) ? '#059669' : '#2563eb' %>; border-color: <%= (typeof isEditor !== 'undefined' && isEditor) ? '#047857' : '#1d4ed8' %>;">+ New Article</a>
    </div>
  </div>

  <div style="overflow-x: auto;">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Title &amp; Department</th>
          <th>Category</th>
          <th>Status</th>
          <th>Views</th>
          <th>Published Date</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (recentPosts && recentPosts.length > 0) { %>
          <% recentPosts.forEach(post => { %>
            <tr>
              <td>
                <div style="font-weight: 700; color: #1e293b; font-size: 14px;">
                  <a href="/author-portal/posts/edit/<%= post.id %>" style="color: inherit; text-decoration: none;">
                    <%= post.title %>
                  </a>
                </div>
                <% if (post.department) { %>
                  <div style="font-size: 12px; color: #64748b;"><%= post.department %></div>
                <% } %>
              </td>
              <td>
                <span class="badge" style="background: #eff6ff; color: #1d4ed8; font-weight: 700;">
                  <%= (categories[post.category] && categories[post.category].name) ? categories[post.category].name : post.category %>
                </span>
              </td>
              <td>
                <% if (post.status === 'active') { %>
                  <span style="display: inline-block; padding: 3px 8px; background: #dcfce7; color: #166534; font-size: 11.5px; font-weight: 700; border-radius: 4px;">Live</span>
                <% } else if (post.status === 'draft') { %>
                  <span style="display: inline-block; padding: 3px 8px; background: #fef3c7; color: #92400e; font-size: 11.5px; font-weight: 700; border-radius: 4px;">Draft</span>
                <% } else { %>
                  <span style="display: inline-block; padding: 3px 8px; background: #f1f5f9; color: #475569; font-size: 11.5px; font-weight: 700; border-radius: 4px;"><%= post.status %></span>
                <% } %>
              </td>
              <td>
                <span style="font-weight: 700; color: #0284c7; font-size: 13px;"><%= post.views || 0 %></span>
              </td>
              <td style="font-size: 12.5px; color: #64748b; white-space: nowrap;">
                <%= post.post_date || formatDate(post.created_at) %>
              </td>
              <td style="text-align: right; white-space: nowrap;">
                <a href="/post/<%= post.slug %>" target="_blank" class="btn btn-secondary btn-sm" title="View live on website">👁️</a>
                <a href="/author-portal/posts/edit/<%= post.id %>" class="btn btn-secondary btn-sm" title="Edit Article">✏️ Edit</a>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; padding: 40px 20px; color: #64748b;">
              <div style="font-size: 32px; margin-bottom: 8px;">📝</div>
              <div style="font-weight: 600; font-size: 15px; color: #1e293b; margin-bottom: 4px;">No articles authored yet</div>
              <p style="margin: 0 0 16px 0; font-size: 13px;">Click below to write your first government exam alert or job notification.</p>
              <a href="/author-portal/posts/new" class="btn btn-primary btn-sm" style="background: #2563eb; border-color: #1d4ed8;">+ Write New Article</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/author-footer') %>

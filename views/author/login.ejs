<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#1e293b">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;700&display=swap" rel="stylesheet">
  <link rel="icon" href="<%= (typeof settings !== 'undefined' && settings.site_favicon) ? settings.site_favicon : '/images/oa-logo.svg' %>">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html, body {
      margin: 0;
      padding: 0;
      width: 100%;
      min-height: 100vh;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
      background-color: #090d16;
    }

    body.author-login-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      padding: 24px 16px;
      position: relative;
      background: 
        radial-gradient(ellipse 70% 40% at 50% -10%, rgba(37, 99, 235, 0.18), transparent),
        radial-gradient(circle 500px at 90% 90%, rgba(13, 148, 136, 0.08), transparent),
        radial-gradient(circle 400px at 10% 85%, rgba(171, 24, 61, 0.08), transparent),
        #090d16;
    }

    .author-login-container {
      width: 100%;
      max-width: 440px;
      position: relative;
      z-index: 2;
    }

    .author-login-card {
      background: rgba(15, 23, 42, 0.82);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border: 1px solid rgba(255, 255, 255, 0.08);
      border-radius: 18px;
      padding: 34px 28px;
      box-shadow: 0 20px 45px -10px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.05);
    }

    @media (max-width: 480px) {
      .author-login-card {
        padding: 26px 20px;
        border-radius: 14px;
      }
    }

    .brand-header {
      text-align: center;
      margin-bottom: 26px;
    }

    .brand-logo-wrap {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 68px;
      height: 68px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 16px;
      padding: 8px;
      margin-bottom: 12px;
    }

    .brand-logo-wrap img {
      width: 100%;
      height: 100%;
      object-fit: contain;
    }

    .brand-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(37, 99, 235, 0.15);
      border: 1px solid rgba(37, 99, 235, 0.35);
      color: #93c5fd;
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 4px 10px;
      border-radius: 999px;
      margin-bottom: 10px;
    }

    .brand-title {
      color: #ffffff;
      font-size: 22px;
      font-weight: 800;
      letter-spacing: -0.02em;
      margin: 0 0 4px 0;
    }

    .brand-sub {
      color: #94a3b8;
      font-size: 13px;
      margin: 0;
      line-height: 1.4;
    }

    .alert-error {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      padding: 12px 14px;
      border-radius: 8px;
      font-size: 13px;
      line-height: 1.45;
      margin-bottom: 20px;
      display: flex;
      align-items: flex-start;
      gap: 8px;
    }

    .form-group {
      margin-bottom: 18px;
    }

    .form-label {
      display: block;
      color: #cbd5e1;
      font-size: 13px;
      font-weight: 600;
      margin-bottom: 6px;
    }

    .input-wrap {
      position: relative;
    }

    .form-input {
      width: 100%;
      background: rgba(30, 41, 59, 0.7);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 10px;
      padding: 12px 14px;
      font-size: 14px;
      color: #f8fafc;
      outline: none;
      transition: all 0.2s ease;
      font-family: inherit;
    }

    .form-input:focus {
      border-color: #3b82f6;
      background: rgba(30, 41, 59, 0.95);
      box-shadow: 0 0 0 3px rgba(59, 130, 246, 0.25);
    }

    .password-toggle-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: transparent;
      border: none;
      color: #94a3b8;
      cursor: pointer;
      padding: 4px;
      font-size: 16px;
      line-height: 1;
    }

    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, #2563eb 0%, #1d4ed8 100%);
      color: #ffffff;
      border: none;
      border-radius: 10px;
      padding: 13px 18px;
      font-size: 14.5px;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      box-shadow: 0 4px 14px rgba(37, 99, 235, 0.4);
      margin-top: 22px;
    }

    .btn-submit:hover {
      background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(37, 99, 235, 0.5);
    }

    .quick-logins-box {
      margin-top: 24px;
      padding-top: 18px;
      border-top: 1px solid rgba(255, 255, 255, 0.08);
    }

    .quick-title {
      color: #94a3b8;
      font-size: 11.5px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .quick-chips-wrap {
      display: flex;
      flex-direction: column;
      gap: 7px;
    }

    .author-chip-btn {
      background: rgba(30, 41, 59, 0.5);
      border: 1px solid rgba(255, 255, 255, 0.07);
      color: #e2e8f0;
      border-radius: 8px;
      padding: 8px 12px;
      font-size: 12px;
      cursor: pointer;
      text-align: left;
      display: flex;
      align-items: center;
      justify-content: space-between;
      transition: all 0.15s ease;
      font-family: inherit;
    }

    .author-chip-btn:hover {
      background: rgba(51, 65, 85, 0.7);
      border-color: rgba(59, 130, 246, 0.4);
      color: #ffffff;
    }

    .portal-footer-links {
      margin-top: 22px;
      text-align: center;
      font-size: 12.5px;
      color: #64748b;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 14px;
      flex-wrap: wrap;
    }

    .portal-footer-links a {
      color: #94a3b8;
      text-decoration: none;
      transition: color 0.15s;
    }

    .portal-footer-links a:hover {
      color: #60a5fa;
    }
  </style>
</head>
<body class="author-login-body">
  <div class="author-login-container">
    <div class="author-login-card">
      <div class="brand-header">
        <div class="brand-logo-wrap">
          <img src="<%= (typeof settings !== 'undefined' && settings.site_logo) ? settings.site_logo : '/images/oa-logo.svg' %>" alt="<%= (typeof settings !== 'undefined' && settings.site_title) ? settings.site_title : 'Odisha Aspirants' %>">
        </div>
        <div>
          <span class="brand-badge">🛡️ Editor &amp; ✍️ Author Contributor Desk</span>
        </div>
        <h1 class="brand-title"><%= (typeof settings !== 'undefined' && settings.site_title) ? settings.site_title : 'Odisha Aspirants' %></h1>
        <p class="brand-sub">Secure workspace for Senior Editors and Author Contributors.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert-error">
          <span style="font-size: 16px;">⚠️</span>
          <span><%= error %></span>
        </div>
      <% } %>

      <form action="/author-portal/login" method="POST" id="authorLoginForm">
        <input type="hidden" name="returnUrl" value="<%= returnUrl %>">

        <div class="form-group">
          <label for="identifier" class="form-label">Author Email or Slug Username</label>
          <div class="input-wrap">
            <input 
              type="text" 
              id="identifier" 
              name="identifier" 
              class="form-input" 
              placeholder="e.g. editor@odishaaspirants.com or editorial-team" 
              required
              autocomplete="username"
              autofocus
            >
          </div>
        </div>

        <div class="form-group">
          <label for="password" class="form-label">Password</label>
          <div class="input-wrap">
            <input 
              type="password" 
              id="password" 
              name="password" 
              class="form-input" 
              placeholder="Enter your author password" 
              required
              autocomplete="current-password"
            >
            <button type="button" class="password-toggle-btn" id="togglePasswordBtn" aria-label="Toggle password visibility">👁️</button>
          </div>
        </div>

        <button type="submit" class="btn-submit">
          <span>🚀 Sign In to Author Portal</span>
        </button>
      </form>

      <!-- Quick 1-Click Fill Chips -->
      <div class="quick-logins-box">
        <div class="quick-title">
          <span>⚡ Quick 1-Click Demo Logins</span>
          <span style="font-size: 11px; text-transform: none; color: #64748b;">Click to populate</span>
        </div>
        <div class="quick-chips-wrap">
          <button type="button" class="author-chip-btn" onclick="fillAuthor('editor@odishaaspirants.com', 'editor@2026')">
            <div>
              <b style="color: #60a5fa;">🛡️ Senior Editor Lead</b>
              <div style="font-size: 11px; color: #94a3b8;">editor@odishaaspirants.com</div>
            </div>
            <span style="background: rgba(37,99,235,0.2); color: #93c5fd; font-size: 11px; padding: 2px 7px; border-radius: 4px;">Fill Editor</span>
          </button>

          <button type="button" class="author-chip-btn" onclick="fillAuthor('amit.sharma@odishaaspirants.com', 'author@2026')">
            <div>
              <b style="color: #34d399;">✍️ Author / Contributor</b>
              <div style="font-size: 11px; color: #94a3b8;">amit.sharma@odishaaspirants.com</div>
            </div>
            <span style="background: rgba(16,185,129,0.2); color: #6ee7b7; font-size: 11px; padding: 2px 7px; border-radius: 4px;">Fill Author</span>
          </button>
        </div>
      </div>

      <div class="portal-footer-links">
        <a href="/">← Main Website</a>
        <span>•</span>
        <a href="/admin/login">Super Admin Desk</a>
      </div>
    </div>
  </div>

  <script>
    const passInput = document.getElementById('password');
    const toggleBtn = document.getElementById('togglePasswordBtn');
    if (toggleBtn && passInput) {
      toggleBtn.addEventListener('click', () => {
        if (passInput.type === 'password') {
          passInput.type = 'text';
          toggleBtn.textContent = '🙈';
        } else {
          passInput.type = 'password';
          toggleBtn.textContent = '👁️';
        }
      });
    }

    function fillAuthor(email, pass) {
      document.getElementById('identifier').value = email;
      document.getElementById('password').value = pass;
    }
  </script>
</body>
</html>

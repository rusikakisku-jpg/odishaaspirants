<script>
  /**
   * Wire live file preview, URL preview, and remove button for branding assets.
   */
  function setupMediaAssetControl(opts) {
    const fileInput = document.getElementById(opts.fileId);
    const previewImg = document.getElementById(opts.imgId);
    const textInput = document.getElementById(opts.textId);
    const pathText = document.getElementById(opts.pathId);
    const emptyText = document.getElementById(opts.emptyId);
    const removeBtn = document.getElementById(opts.removeBtnId);

    if (fileInput && previewImg) {
      fileInput.addEventListener('change', function(e) {
        const file = e.target.files && e.target.files[0];
        if (!file) return;
        const reader = new FileReader();
        reader.onload = function(evt) {
          previewImg.src = evt.target.result;
          previewImg.style.display = 'block';
          if (emptyText) emptyText.style.display = 'none';
          if (pathText) {
            pathText.style.color = '#0284c7';
            pathText.textContent = 'Selected: ' + file.name + ' (will upload on save)';
          }
        };
        reader.readAsDataURL(file);
      });
    }

    if (textInput && previewImg) {
      textInput.addEventListener('input', function() {
        const val = this.value.trim();
        if (val) {
          previewImg.src = val;
          previewImg.style.display = 'block';
          if (emptyText) emptyText.style.display = 'none';
          if (pathText) {
            pathText.style.color = '#0284c7';
            pathText.textContent = val;
          }
        } else {
          previewImg.src = '';
          previewImg.style.display = 'none';
          if (emptyText) emptyText.style.display = 'inline-block';
          if (pathText) {
            pathText.style.color = '#dc2626';
            pathText.textContent = opts.emptyStatus;
          }
        }
      });
    }

    if (removeBtn && textInput) {
      removeBtn.addEventListener('click', function() {
        textInput.value = '';
        if (fileInput) fileInput.value = '';
        if (previewImg) {
          previewImg.src = '';
          previewImg.style.display = 'none';
        }
        if (emptyText) emptyText.style.display = 'inline-block';
        if (pathText) {
          pathText.style.color = '#dc2626';
          pathText.textContent = opts.clearedStatus;
        }
      });
    }
  }

  setupMediaAssetControl({
    fileId: 'site_logo_file',
    imgId: 'logoPreviewImg',
    textId: 'site_logo',
    pathId: 'logoPathText',
    emptyId: 'logoNoLogoText',
    removeBtnId: 'removeLogoBtn',
    emptyStatus: 'No logo active (Header displays text title only)',
    clearedStatus: 'Logo cleared. Click "Save All Settings" below to apply changes.'
  });

  setupMediaAssetControl({
    fileId: 'site_favicon_file',
    imgId: 'faviconPreviewImg',
    textId: 'site_favicon',
    pathId: 'faviconPathText',
    emptyId: 'faviconNoIconText',
    removeBtnId: 'removeFaviconBtn',
    emptyStatus: 'No custom favicon active (Browser default)',
    clearedStatus: 'Favicon cleared. Click "Save All Settings" below to apply changes.'
  });

  // Interactive visual selection for Post Layout cards
  document.querySelectorAll('.layout-option-card input[type="radio"]').forEach(function(radio) {
    radio.addEventListener('change', function() {
      document.querySelectorAll('.layout-option-card').forEach(function(card) {
        card.classList.remove('selected');
      });
      if (this.checked) {
        this.closest('.layout-option-card').classList.add('selected');
      }
    });
  });

  // Category Visibility quick actions & live card styling
  function syncCatVisCard(cb) {
    const card = cb.closest('.cat-vis-card');
    if (!card) return;
    const statusLabel = card.querySelector('.cat-vis-status-label');
    if (cb.checked) {
      card.style.borderColor = '#86efac';
      card.style.background = '#f0fdf4';
      if (statusLabel) { statusLabel.textContent = 'Visible'; statusLabel.style.color = '#166534'; }
    } else {
      card.style.borderColor = '#fecaca';
      card.style.background = '#fef2f2';
      if (statusLabel) { statusLabel.textContent = 'Hidden'; statusLabel.style.color = '#991b1b'; }
    }
  }

  document.querySelectorAll('.cat-vis-checkbox').forEach(function(cb) {
    cb.addEventListener('change', function() { syncCatVisCard(cb); });
  });

  const btnHideEmptyCats = document.getElementById('btnHideEmptyCats');
  if (btnHideEmptyCats) {
    btnHideEmptyCats.addEventListener('click', function() {
      document.querySelectorAll('.cat-vis-card').forEach(function(card) {
        const count = parseInt(card.getAttribute('data-post-count') || '0', 10);
        const cb = card.querySelector('.cat-vis-checkbox');
        if (cb && count === 0) {
          cb.checked = false;
          syncCatVisCard(cb);
        }
      });
    });
  }

  const btnShowAllCats = document.getElementById('btnShowAllCats');
  if (btnShowAllCats) {
    btnShowAllCats.addEventListener('click', function() {
      document.querySelectorAll('.cat-vis-checkbox').forEach(function(cb) {
        cb.checked = true;
        syncCatVisCard(cb);
      });
    });
  }
</script>


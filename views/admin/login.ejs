<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
  <meta name="theme-color" content="#0f172a">
  <title><%= title %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=JetBrains+Mono:wght@500;600&display=swap" rel="stylesheet">
  <link rel="icon" href="<%= (typeof settings !== 'undefined' && settings.site_favicon) ? settings.site_favicon : '/images/oa-logo.svg' %>">
  <style>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      min-height: 100vh;
      min-height: 100dvh;
      display: grid;
      place-items: center;
      padding: 16px;
      font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: radial-gradient(ellipse 80% 50% at 50% -20%, rgba(171, 24, 61, 0.22), transparent 70%),
                  radial-gradient(circle 400px at 80% 90%, rgba(2, 132, 199, 0.1), transparent),
                  #0b1120;
      color: #f8fafc;
      overflow-x: hidden;
      position: relative;
    }

    /* Ambient Subtle Grid */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: 
        linear-gradient(to right, rgba(255, 255, 255, 0.025) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
      background-size: 28px 28px;
      pointer-events: none;
      z-index: 1;
    }

    .login-wrap {
      width: 100%;
      max-width: 380px;
      position: relative;
      z-index: 2;
    }

    /* Compact Glassmorphism Card */
    .login-card {
      background: rgba(17, 24, 39, 0.88);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255, 255, 255, 0.09);
      border-radius: 18px;
      padding: 28px 24px 22px;
      box-shadow: 0 20px 40px -15px rgba(0, 0, 0, 0.7),
                  0 0 0 1px rgba(255, 255, 255, 0.04),
                  0 0 35px rgba(171, 24, 61, 0.12);
    }

    /* Sleek Header */
    .brand-header {
      text-align: center;
      margin-bottom: 20px;
    }

    .brand-emblem {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 52px;
      height: 52px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.12);
      border-radius: 14px;
      padding: 7px;
      margin-bottom: 10px;
      box-shadow: 0 6px 16px rgba(0, 0, 0, 0.4);
      transition: transform 0.2s ease;
      text-decoration: none;
    }

    .brand-emblem:hover {
      transform: scale(1.05);
      border-color: rgba(171, 24, 61, 0.4);
    }

    .brand-emblem img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      display: block;
    }

    .brand-title {
      font-size: 20px;
      font-weight: 800;
      color: #ffffff;
      letter-spacing: -0.4px;
      margin-bottom: 4px;
    }

    .brand-subtitle {
      font-size: 12.5px;
      color: #94a3b8;
    }

    /* Alert */
    .alert-box {
      background: rgba(239, 68, 68, 0.12);
      border: 1px solid rgba(239, 68, 68, 0.3);
      color: #fca5a5;
      padding: 9px 12px;
      border-radius: 8px;
      font-size: 12.5px;
      margin-bottom: 16px;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    /* Form Fields */
    .form-group {
      margin-bottom: 14px;
      text-align: left;
    }

    .form-group label {
      display: block;
      font-size: 12px;
      font-weight: 600;
      color: #cbd5e1;
      margin-bottom: 5px;
      letter-spacing: 0.1px;
    }

    .input-box {
      position: relative;
      display: flex;
      align-items: center;
    }

    .input-box svg {
      position: absolute;
      left: 13px;
      width: 16px;
      height: 16px;
      fill: #64748b;
      pointer-events: none;
      transition: fill 0.2s ease;
    }

    .input-control {
      width: 100%;
      padding: 10px 12px 10px 38px;
      font-size: 14px;
      font-family: inherit;
      color: #ffffff;
      background: rgba(15, 23, 42, 0.6);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 9px;
      outline: none;
      transition: all 0.2s ease;
    }

    .input-control::placeholder {
      color: #475569;
    }

    .input-control:focus {
      border-color: #ab183d;
      background: rgba(15, 23, 42, 0.9);
      box-shadow: 0 0 0 3px rgba(171, 24, 61, 0.2);
    }

    .input-box:focus-within svg {
      fill: #ff4d73;
    }

    /* Password Toggle */
    .input-box.pwd input {
      padding-right: 38px;
    }

    .btn-toggle-pwd {
      position: absolute;
      right: 4px;
      background: transparent;
      border: none;
      cursor: pointer;
      color: #94a3b8;
      padding: 6px 8px;
      border-radius: 6px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 15px;
      transition: color 0.15s ease;
    }

    .btn-toggle-pwd:hover {
      color: #ffffff;
    }

    /* Primary Submit Button */
    .btn-submit {
      width: 100%;
      background: linear-gradient(135deg, #ab183d 0%, #7e0e29 100%);
      color: #ffffff;
      border: none;
      padding: 11px 16px;
      font-size: 14px;
      font-weight: 700;
      border-radius: 9px;
      cursor: pointer;
      box-shadow: 0 4px 12px rgba(171, 24, 61, 0.35);
      transition: all 0.2s ease;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 7px;
      margin-top: 18px;
    }

    .btn-submit:hover {
      background: linear-gradient(135deg, #bd1b44 0%, #8f1230 100%);
      box-shadow: 0 6px 18px rgba(171, 24, 61, 0.5);
      transform: translateY(-1px);
    }

    .btn-submit:active {
      transform: translateY(0);
    }

    /* Compact 1-Line Quick Access Demo Pill */
    .quick-access-bar {
      margin-top: 14px;
      padding: 8px 10px;
      background: rgba(255, 255, 255, 0.03);
      border: 1px dashed rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 6px;
      font-size: 11.5px;
      color: #94a3b8;
    }

    .quick-access-info {
      display: flex;
      align-items: center;
      gap: 6px;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .quick-access-info code {
      font-family: 'JetBrains Mono', monospace;
      color: #ff8da6;
      background: rgba(171, 24, 61, 0.2);
      padding: 1px 5px;
      border-radius: 4px;
      font-size: 11px;
    }

    .btn-autofill {
      background: rgba(2, 132, 199, 0.15);
      border: 1px solid rgba(2, 132, 199, 0.35);
      color: #38bdf8;
      font-size: 11px;
      font-weight: 700;
      padding: 3px 8px;
      border-radius: 5px;
      cursor: pointer;
      white-space: nowrap;
      transition: all 0.15s ease;
    }

    .btn-autofill:hover {
      background: rgba(2, 132, 199, 0.3);
      color: #7dd3fc;
      border-color: rgba(2, 132, 199, 0.6);
    }

    /* Footer Meta */
    .card-footer {
      margin-top: 16px;
      text-align: center;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .card-footer a {
      font-size: 12px;
      color: #64748b;
      text-decoration: none;
      transition: color 0.15s ease;
    }

    .card-footer a:hover {
      color: #cbd5e1;
    }

    .security-note {
      font-size: 10.5px;
      color: #475569;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }
  </style>
</head>
<body>

<div class="login-wrap">
  <div class="login-card">
    
    <!-- Brand Header -->
    <div class="brand-header">
      <a href="<%= (typeof publicBase !== 'undefined' ? publicBase : '') %>/" class="brand-emblem" title="Back to Homepage">
        <img src="<%= (typeof settings !== 'undefined' && settings.site_logo) ? settings.site_logo : '/images/oa-logo.svg' %>" alt="Logo">
      </a>
      <h1 class="brand-title">Admin Console</h1>
      <p class="brand-subtitle">Odisha Aspirants Administration</p>
    </div>

    <!-- Error Alert -->
    <% if (error) { %>
      <div class="alert-box">
        <span>⚠️</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <!-- Sign In Form -->
    <form id="adminLoginForm" action="<%= (typeof adminBase !== 'undefined' ? adminBase : '/admin') %>/login" method="POST">
      
      <!-- Username -->
      <div class="form-group">
        <label for="username">Username</label>
        <div class="input-box">
          <svg viewBox="0 0 24 24"><path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/></svg>
          <input 
            type="text" 
            id="username" 
            name="username" 
            class="input-control" 
            placeholder="admin" 
            required 
            autofocus 
            autocomplete="username"
            spellcheck="false"
          >
        </div>
      </div>

      <!-- Password -->
      <div class="form-group">
        <label for="password">Password</label>
        <div class="input-box pwd">
          <svg viewBox="0 0 24 24"><path d="M18 8h-1V6c0-2.76-2.24-5-5-5S7 3.24 7 6v2H6c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V10c0-1.1-.9-2-2-2zm-6 9c-1.1 0-2-.9-2-2s.9-2 2-2 2 .9 2 2-.9 2-2 2zm3.1-9H8.9V6c0-1.71 1.39-3.1 3.1-3.1 1.71 0 3.1 1.39 3.1 3.1v2z"/></svg>
          <input 
            type="password" 
            id="password" 
            name="password" 
            class="input-control" 
            placeholder="••••••••••••" 
            required 
            autocomplete="current-password"
          >
          <button type="button" class="btn-toggle-pwd" id="pwdToggle" title="Toggle password visibility">
            👁️
          </button>
        </div>
      </div>

      <!-- Submit Button -->
      <button type="submit" class="btn-submit">
        <span>Sign In</span>
        <span>→</span>
      </button>

      <!-- Minimal 1-Line Quick Access -->
      <div class="quick-access-bar">
        <div class="quick-access-info">
          <span>Demo:</span>
          <code>admin</code>
          <span>/</span>
          <code>odishaaspirants@2026</code>
        </div>
        <button type="button" class="btn-autofill" id="quickFillBtn" title="Fill credentials & login">
          ⚡ Auto-Fill
        </button>
      </div>
    </form>

    <!-- Footer Links -->
    <div class="card-footer">
      <a href="<%= (typeof publicBase !== 'undefined' ? publicBase : '') %>/">← Return to Homepage</a>
      <div class="security-note">
        <span>🔒 256-Bit SSL Encrypted • D1 &amp; R2 Protected</span>
      </div>
    </div>

  </div>
</div>

<script>
  // Toggle password visibility
  const pwdInput = document.getElementById('password');
  const pwdToggle = document.getElementById('pwdToggle');
  if (pwdInput && pwdToggle) {
    pwdToggle.addEventListener('click', () => {
      if (pwdInput.type === 'password') {
        pwdInput.type = 'text';
        pwdToggle.textContent = '🔒';
      } else {
        pwdInput.type = 'password';
        pwdToggle.textContent = '👁️';
      }
    });
  }

  // 1-Click Auto Fill & Submit
  const quickFillBtn = document.getElementById('quickFillBtn');
  const userField = document.getElementById('username');
  const form = document.getElementById('adminLoginForm');
  if (quickFillBtn && userField && pwdInput && form) {
    quickFillBtn.addEventListener('click', () => {
      userField.value = 'admin';
      pwdInput.value = 'odishaaspirants@2026';
      form.submit();
    });
  }
</script>

</body>
</html>

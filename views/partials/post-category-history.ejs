<%
  const historyMap = (typeof categoryHistoryMap !== 'undefined' && categoryHistoryMap) ? categoryHistoryMap : {};
  const primaryCatVal = (typeof post !== 'undefined' && post && post.category) ? post.category : 'latest-jobs';
%>
<!-- Category History & Multi-Section Appearances (Preserves Old Section Titles with Same Slug) -->
<div id="categoryHistoryPanel" data-initial-primary="<%= post ? primaryCatVal : '' %>" style="background: #f8fafc; border: 1px solid #cbd5e1; border-radius: 8px; padding: 14px 16px; margin-bottom: 18px;">
  <input type="hidden" name="has_category_history_ui" value="1">
  <div style="display: flex; justify-content: space-between; align-items: flex-start; gap: 10px; flex-wrap: wrap; margin-bottom: 10px;">
    <div>
      <div style="font-size: 14px; font-weight: 700; color: #0f172a;">
        📌 Category History &amp; Section Titles (Same Slug Across All Stages)
      </div>
      <div style="font-size: 12px; color: #475569; margin-top: 2px;">
        Jab aap Category change karenge (e.g. <b>Latest Jobs → Admit Card → Result</b>), purani category aur uska purana title automatically preserve rahega aur URL slug same rahega.
      </div>
    </div>
    <% if (post) { %>
      <label style="display: inline-flex; align-items: center; gap: 6px; font-size: 12px; font-weight: 600; color: #1d4ed8; background: #eff6ff; padding: 5px 10px; border-radius: 6px; border: 1px solid #bfdbfe; cursor: pointer;">
        <input type="checkbox" name="bump_primary" value="1" id="bumpPrimaryCheckbox">
        <span>🔝 Bump Primary Category to Top</span>
      </label>
    <% } %>
  </div>

  <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 8px;">
    <% Object.keys(categories).forEach(catKey => { %>
      <%
        const savedInfo = historyMap[catKey] || null;
        const isPrimary = Boolean(post ? (primaryCatVal === catKey) : (catKey === 'latest-jobs'));
        const isChecked = Boolean(isPrimary || savedInfo);
        const savedTitle = savedInfo ? (savedInfo.display_title || '') : (isPrimary && post ? (post.title || '') : '');
      %>
      <div class="cat-history-row" data-cat-key="<%= catKey %>" style="background: #ffffff; border: 1px solid <%= isPrimary ? '#3b82f6' : '#e2e8f0' %>; border-radius: 6px; padding: 8px 10px; display: flex; flex-direction: column; gap: 6px;">
        <label style="display: flex; align-items: center; justify-content: space-between; gap: 6px; margin: 0; font-size: 12.5px; font-weight: 700; color: #1e293b; cursor: pointer;">
          <span style="display: inline-flex; align-items: center; gap: 6px;">
            <input
              type="checkbox"
              name="extra_categories"
              value="<%= catKey %>"
              class="cat-history-checkbox"
              data-cat-key="<%= catKey %>"
              <%= isChecked ? 'checked' : '' %>
            >
            <span><%= categories[catKey].name %></span>
          </span>
          <span class="cat-primary-badge" data-cat-key="<%= catKey %>" style="font-size: 10px; font-weight: 700; padding: 1px 6px; border-radius: 999px; background: <%= isPrimary ? '#dbeafe' : (savedInfo ? '#dcfce7' : '#f1f5f9') %>; color: <%= isPrimary ? '#1d4ed8' : (savedInfo ? '#15803d' : '#64748b') %>;">
            <%= isPrimary ? 'Primary' : (savedInfo ? 'Preserved' : 'Optional') %>
          </span>
        </label>
        <input
          type="text"
          name="cat_title_<%= catKey %>"
          class="form-control cat-history-title-input"
          data-cat-key="<%= catKey %>"
          data-saved-title="<%= savedTitle %>"
          value="<%= savedTitle %>"
          placeholder="Section title (defaults to Post Title)"
          style="font-size: 12px; padding: 6px 8px;"
        >
      </div>
    <% }) %>
  </div>
</div>
